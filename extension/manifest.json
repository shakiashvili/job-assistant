{
  "manifest_version": 3,
  "name": "TalentFlow AI Job Copilot",
  "version": "3.1.0",
  "description": "Domain-agnostic AI Job Copilot: authenticates with TalentFlow, analyzes LinkedIn/Workday/Greenhouse/Georgian jobs, builds & downloads tailored ATS PDF/DOCX CVs, fills multi-step forms safely, and syncs to the Kanban Tracker.",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "storage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "*://*.linkedin.com/jobs/*",
    "*://*.myworkdayjobs.com/*",
    "*://boards.greenhouse.io/*",
    "*://job-boards.greenhouse.io/*",
    "*://jobs.lever.co/*",
    "*://djinni.co/*",
    "*://jobs.dou.ua/*",
    "*://jobs.ge/*",
    "*://www.jobs.ge/*",
    "*://hr.ge/*",
    "*://www.hr.ge/*",
    "*://vacancy.hr.gov.ge/*",
    "*://hr.gov.ge/*",
    "*://*.headhunter.ge/*",
    "*://justjoin.it/*",
    "*://*.ashbyhq.com/*",
    "*://*.workable.com/*",
    "*://*.smartrecruiters.com/*",
    "*://*.bamboohr.com/*",
    "*://*.breezy.hr/*",
    "*://*.recruitee.com/*",
    "*://*.teamtailor.com/*",
    "*://remotive.com/*",
    "*://himalayas.app/*",
    "*://remoteok.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "action": {
    "default_title": "TalentFlow AI Job Copilot (Side Panel)"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "*://*.linkedin.com/jobs/*",
        "*://*.myworkdayjobs.com/*",
        "*://boards.greenhouse.io/*",
        "*://job-boards.greenhouse.io/*",
        "*://jobs.lever.co/*",
        "*://djinni.co/jobs/*",
        "*://jobs.dou.ua/vacancies/*",
        "*://jobs.ge/*",
        "*://www.jobs.ge/*",
        "*://hr.ge/*",
        "*://www.hr.ge/*",
        "*://vacancy.hr.gov.ge/*",
        "*://hr.gov.ge/*",
        "*://*.headhunter.ge/*",
        "*://justjoin.it/job-offers/*",
        "*://*.ashbyhq.com/*",
        "*://*.workable.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.bamboohr.com/*",
        "*://*.breezy.hr/*",
        "*://*.recruitee.com/*",
        "*://*.teamtailor.com/*",
        "*://remotive.com/*",
        "*://himalayas.app/*",
        "*://remoteok.com/*"
      ],
      "js": [
        "shared/extractors.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
