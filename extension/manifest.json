{
  "manifest_version": 3,
  "name": "TalentFlow AI Job Copilot",
  "version": "3.0.0",
  "description": "Domain-agnostic AI Job Copilot: authenticates with TalentFlow, analyzes LinkedIn/Workday/Greenhouse/Georgian jobs, builds tailored ATS PDFs, and fills multi-step forms safely (Human-in-the-Loop).",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.myworkdayjobs.com/*",
    "*://boards.greenhouse.io/*",
    "*://job-boards.greenhouse.io/*",
    "*://jobs.lever.co/*",
    "*://djinni.co/*",
    "*://jobs.dou.ua/*",
    "*://jobs.ge/*",
    "*://www.jobs.ge/*",
    "*://hr.ge/*",
    "*://www.hr.ge/*",
    "*://vacancy.hr.gov.ge/*",
    "*://hr.gov.ge/*",
    "*://*.headhunter.ge/*",
    "*://justjoin.it/*",
    "*://mail.google.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:5173/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "action": {
    "default_title": "TalentFlow AI Job Copilot (Side Panel)"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/jobs/*",
        "*://*.myworkdayjobs.com/*",
        "*://boards.greenhouse.io/*",
        "*://job-boards.greenhouse.io/*",
        "*://jobs.lever.co/*",
        "*://djinni.co/jobs/*",
        "*://jobs.dou.ua/vacancies/*",
        "*://jobs.ge/*",
        "*://www.jobs.ge/*",
        "*://hr.ge/*",
        "*://www.hr.ge/*",
        "*://vacancy.hr.gov.ge/*",
        "*://hr.gov.ge/*",
        "*://*.headhunter.ge/*",
        "*://justjoin.it/job-offers/*",
        "http://localhost:8000/mock-portals/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
