# ==============================================================================
# TalentFlow AI — Environment Configuration Template
# Copy to backend/.env (and frontend/.env for custom API origin)
# NEVER commit real secrets, API keys, OAuth client JSON, or .db files to Git.
# ==============================================================================

# --- Database Persistence ---
# Local development (SQLite with WAL mode enabled automatically):
DATABASE_URL=sqlite:///../data/job_assistant.db
# Production PostgreSQL (e.g., Neon, Supabase, Railway, or Render Postgres):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require

# --- Security & JWT Sessions (REQUIRED in Production) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-strong-random-secret-key
# Dedicated Fernet key for encrypted database PII columns (REQUIRED in Production):
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-fernet-base64-key
# Optional previous Fernet key(s) during ENCRYPTION_KEY rotation (comma-separated):
# ENCRYPTION_KEY_PREVIOUS=
# Dedicated independent HMAC key for email blind indexes (REQUIRED in Production, never reuse ENCRYPTION_KEY):
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
BLIND_INDEX_KEY=replace-with-strong-independent-blind-index-key
# Optional previous blind-index key(s) during key rotation or legacy upgrade (comma-separated):
# BLIND_INDEX_KEY_PREVIOUS=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
ENVIRONMENT=development

# --- CORS Allowed Frontend Origins (comma-separated) ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI Pipeline & Free-Tier Fallback Routing ---
# AI_PROVIDER: auto (Gemini -> OpenRouter :free -> deterministic), gemini, or openrouter
AI_PROVIDER=auto
AI_FALLBACK_PROVIDER=auto
# Safety guard: prevent silent switch to paid OpenRouter models (only :free models allowed when false)
AI_ALLOW_PAID_FALLBACK=false

# Primary Google Gemini Free-Tier / Flash models (leave empty for deterministic or OpenRouter-only mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000

# Optional OpenRouter Free-Tier Fallback (OpenAI-compatible; free models end with :free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-27b-it:free
OPENROUTER_FAST_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_TIMEOUT_SECONDS=25

# LinkedIn public scraping is opt-in (false by default; use extension capture or manual job URL/JD)
ENABLE_LINKEDIN_PUBLIC_SCRAPE=false

# --- Durable Document Storage (Cloudflare R2 / AWS S3 recommended for production) ---
# When unset, encrypted document blobs persist automatically in PostgreSQL/SQLite (`db_blob`).
# S3_BUCKET=
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_PREFIX=talentflow

# --- Background Scrape Worker Durability ---
SCRAPE_WORKER_MODE=embedded
SCRAPE_STALE_TIMEOUT_SECONDS=180
SCRAPE_EXECUTION_TIMEOUT_SECONDS=240

# --- Email OTP & Transactional Delivery ---
# Set OTP_EMAIL_ENABLED=false for password-only launch.
# In cloud hosting (e.g. Render Free where SMTP ports 25/465/587 are blocked), use HTTPS APIs:
OTP_EMAIL_ENABLED=true
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# EMAIL_FROM=TalentFlow AI <no-reply@yourdomain.com>
# Local development Gmail SMTP fallback:
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Google OAuth 2.0 (Optional for Gmail Drafts / Direct Send) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Frontend (frontend/.env) ---
VITE_API_BASE_URL=http://localhost:8000
