# Copy this file to backend/.env (or root .env) to enable live Gmail OTP & AI API features.
# Note: Never commit .env to Git (already listed in .gitignore).

# Gmail SMTP Configuration (to send real OTP verification codes & emails via Gmail)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional Google Gemini API Key & Model Tiering
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000
GEMINI_PRICING_TIER=standard
# Optional JSON override for custom model pricing rates:
# GEMINI_MODEL_PRICING_JSON={"gemini-3.6-flash":{"standard":[0.75,3.75]}}

# Required in production for column-level encryption and independent blind indexes:
# ENCRYPTION_KEY=
# ENCRYPTION_KEY_PREVIOUS=
# BLIND_INDEX_KEY=
# BLIND_INDEX_KEY_PREVIOUS=

# Optional HTTPS Transactional Email API for OTP (recommended on Render/cloud hosts where SMTP ports 25/465/587 are blocked)
OTP_EMAIL_ENABLED=true
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# EMAIL_FROM=TalentFlow AI <no-reply@yourdomain.com>

# Optional S3 / Cloudflare R2 Object Storage for uploaded & generated CVs (falls back to encrypted DB blobs)
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# Background Scrape Worker Durability (`embedded` or `external` via `python -m app.services.scrape_worker`)
SCRAPE_WORKER_MODE=embedded
SCRAPE_STALE_TIMEOUT_SECONDS=180
SCRAPE_EXECUTION_TIMEOUT_SECONDS=240

# Optional shared Redis URL for distributed auth rate limiting (falls back to SQL auth_rate_limits table):
# REDIS_URL=redis://localhost:6379/0

# Optional Google OAuth2 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
