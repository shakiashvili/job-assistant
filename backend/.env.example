# Copy this file to backend/.env (or root .env) to enable live Gmail OTP & AI API features.
# Note: Never commit .env to Git (already listed in .gitignore).

# Gmail SMTP Configuration (to send real OTP verification codes & emails via Gmail)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional Google Gemini API Key
GEMINI_API_KEY=

# Optional Google OAuth2 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
